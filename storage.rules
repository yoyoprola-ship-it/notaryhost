rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Directory photos — publicly viewable, only the admin can upload.
    match /notaryPhotos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'yoyoprola@gmail.com';
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
