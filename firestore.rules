rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'yoyoprola@gmail.com';
    }

    match /notaries/{notaryId} {
      allow read, write: if isAdmin();
    }

    match /publicNotaryProfiles/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // notarygarcia — independent App Hosting backend sharing this project.
    // Its own /admin panel was removed (superseded by notaryhost's central
    // Operations tab, which uses the Admin SDK and bypasses these rules
    // entirely). Only the owner's own-doc session read remains — the
    // owner login/layout still reads notarygarcia_users/{uid} client-side.
    match /notarygarcia_users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
